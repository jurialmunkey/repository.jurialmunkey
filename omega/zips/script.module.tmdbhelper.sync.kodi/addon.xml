<?xml version="1.0" encoding="UTF-8"?>
<addon id="script.module.tmdbhelper.sync.kodi" version="1.1.1" name="TMDbHelper Sync - Kodi" provider-name="jurialmunkey">
    <requires>
        <import addon="xbmc.python" version="3.0.1"/>
        <import addon="script.module.jurialmunkey" version="0.2.35"/>
        <import addon="plugin.video.themoviedb.helper" version="6.18.3"/>
    </requires>
    <extension point="xbmc.python.module" library="resources/lib"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Kodi library sync provider for TMDbHelper</summary>
        <description lang="en_GB">Collection, history, playback progress, watched actions and scrobbling using the local Kodi video library, with separate local history/progress for non-library items and a local watchlist.</description>
        <platform>all</platform>
        <license>GPL-3.0-or-later</license>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
